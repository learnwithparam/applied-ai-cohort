{
  "name": "applied-ai-cohort",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "check": "bun scripts/readable.ts && bun scripts/plain-english.ts && bun scripts/check.ts && bun scripts/verify.ts --all && bun scripts/audit.ts",
    "verify": "bun scripts/verify.ts",
    "shots": "bun images/shoot.ts",
    "readable": "bun scripts/readable.ts",
    "format": "biome check --write .",
    "plain-english": "bun scripts/plain-english.ts",
    "audit": "bun scripts/audit.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@playwright/test": "1.65.0",
    "@types/bun": "1.4.4",
    "playwright": "1.65.0"
  }
}
